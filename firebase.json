{
  "hosting": {
    "public": "web",
    "predeploy": ["npm run css"],
    "ignore": ["**/.*", "css/entrada.css"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "medalhas", "region": "southamerica-east1" } },
      { "source": "/aluno/**", "run": { "serviceId": "medalhas", "region": "southamerica-east1" } },
      { "source": "/escola/**", "run": { "serviceId": "medalhas", "region": "southamerica-east1" } },
      { "regex": "^/(ranking(/[a-z]+)?|estados|busca|dados|sobre)/?$", "run": { "serviceId": "medalhas", "region": "southamerica-east1" } },
      { "source": "/sitemap.xml", "run": { "serviceId": "medalhas", "region": "southamerica-east1" } },
      { "source": "/sitemaps/**", "run": { "serviceId": "medalhas", "region": "southamerica-east1" } }
    ],
    "headers": [
      {
        "regex": "^/(index\\.html)?$",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
      }
    ]
  }
}
