{
  "hosting": {
    "public": "web",
    "ignore": ["**/.*"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "medalhas", "region": "southamerica-east1" }
      }
    ],
    "headers": [
      {
        "regex": "^/(index\\.html)?$",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
      }
    ]
  }
}
